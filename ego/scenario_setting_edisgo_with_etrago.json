{
  "_comment": "eDisGo laeuft pro Netz ueber edisgo.run.run_edisgo mit dem Preset aus eDisGo.preset (worst_case | flex_opf | overlying_grid_opf oder Pfad zu eigenem YAML). Datenbank: Auto-Detect — existiert ~/.ssh/egon-data.configuration.yaml (bzw. EGON_DATA_CONFIG), wird die darin beschriebene egon-data-DB genutzt (inkl. SSH-Tunnel, falls dort konfiguriert), sonst die OEP.",
  "eGo": {
    "eTraGo": true,
    "eDisGo": true,
    "csv_import_eTraGo": false,
    "csv_import_eDisGo": false,
    "random_seed": 42
  },
  "eTraGo": {
    "method": {
      "n_iter": 1,
      "formulation": "pyomo",
      "market_optimization": {
        "active": false
      },
      "distribution_grids": false
    },
    "pf_post_lopf": {
      "active": true
    },
    "start_snapshot": 1,
    "end_snapshot": 25,
    "scn_name": "eGon2035",
    "spatial_disaggregation": "uniform",
    "skip_snapshots": false,
    "temporal_disaggregation": {
      "active": false,
      "no_slices": 8
    },
    "load_shedding": true
  },
  "eDisGo": {
    "overlying_grid": true,
    "overlying_grid_source": "etrago",
    "preset": "overlying_grid_opf",
    "grid_path": "/home/path_to/grids",
    "legacy_ding0_grids": false,
    "choice_mode": "manual",
    "cluster_attributes": [],
    "only_cluster": false,
    "manual_grids": [
      32377
    ],
    "n_clusters": 1,
    "parallelization": false,
    "max_calc_time": 1.0,
    "max_workers": 1,
    "max_cos_phi_renewable": 0.9,
    "results": "/home/path_to/results",
    "solver": "gurobi",
    "gridversion": null
  }
}
